<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1>All articles page</h1>
    <hr/>
    <div style="background: rgb(111, 224, 66);">
        <% for( let article of articles ) { %>
            <h3><%= article.title %></h3>
            <p style="background: rgb(255, 153, 0);"><%= article.body %></p>
        <% } %>
    </div>             
</body>
</html>